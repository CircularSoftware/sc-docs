# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/

# Build output (regenerated by CI; not the source of truth)
site/

# OMC / editor state
.omc/
.DS_Store

# Notion sync scratch
.notion-cache/

# NOTE: docs/ is generated but IS committed on purpose (see README) —
# it gives a readable diff of editor changes and enables `git revert` of a bad sync.
