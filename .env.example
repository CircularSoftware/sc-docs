# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Notion internal integration token (read content only). Phase 1.2.
NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Docs database id — the /p/<id> segment of the shared Notion URL. Required.
NOTION_DATABASE_ID=your-notion-database-id

# --- CI-only secrets (set in the GitHub repo, not needed for local sync) ---
# Cloudflare Pages deploy (Phase 4.2). Create a scoped API token with the
# "Cloudflare Pages: Edit" permission.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_PROJECT_NAME=sc-docs

# Slack incoming webhook for build-failure alerts (Phase 4.3 — the load-bearing part).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
